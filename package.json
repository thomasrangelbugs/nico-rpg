{
  "name": "nicolas-chronicles-of-eldoria",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate-assets": "node scripts/generate-assets.mjs",
    "generate-audio": "node scripts/generate-audio.mjs",
    "postinstall": "node scripts/patch-rollup.mjs",
    "prebuild": "node scripts/patch-rollup.mjs && node scripts/generate-assets.mjs && node scripts/generate-audio.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:engine": "node scripts/patch-rollup.mjs && npx esbuild src/game/engine.ts --bundle --format=esm --outfile=scripts/_engine.bundle.mjs --platform=neutral && node scripts/run-engine-tests.mjs"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@rollup/wasm-node": "^4.63.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.0",
    "lamejs": "^1.2.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
